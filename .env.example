# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# The server refuses to start if a value below is still a placeholder, too short or too repetitive.

# Bearer token the AI host (Claude connector header / MCP Inspector) must send to /mcp.
MCP_TOKEN=replace-with-a-long-random-string

# Invite code: needed to create a dashboard account on the sign-up page (at least 12 characters).
DASHBOARD_PASSCODE=replace-me

# Optional owner account, recreated at every start (survives database resets). Both or neither;
# the password needs at least 12 varied characters. OWNER_NAME defaults to the demo student's name.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Secret used to sign the dashboard session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# SQLite database file. Re-created from seed data when missing.
DATABASE_PATH=./data/campusmate.db

# Public HTTPS origin of the deployed service (also used for the MCP allowed-hosts check).
# On Render it can be left unset: RENDER_EXTERNAL_URL is used instead.
PUBLIC_URL=http://localhost:8787

PORT=8787

# Number of trusted proxies in front of the server that append to X-Forwarded-For (1 on Render).
# Keep 0 when the server is reached directly: the header is then set by the visitor and can be faked.
TRUST_PROXY_HOPS=0

# Optional: Google Calendar for approved reminders (see docs/integrations.md).
# Leave both empty to keep reminders in CampusMate only. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
