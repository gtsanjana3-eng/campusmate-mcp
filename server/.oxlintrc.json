{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "vitest", "unicorn", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": ["warn", { "allow": ["info", "error"] }]
  },
  "ignorePatterns": ["data/**"]
}
