{
  "name": "@campusmate/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CampusMate MCP server, REST API and static host for the dashboard.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.95.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
